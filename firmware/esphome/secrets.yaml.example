# Copy to secrets.yaml and fill in. secrets.yaml is gitignored, this file is not.
#
# Generate the api key with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# Baking in your WiFi creds will simplify the setup process. See ESPHome docs for more infromation.

wifi_ssid: "your network"
wifi_password: "your password"
ap_password: "fallback ap password"
ota_password: "ota password"
api_key: "base64 key, 32 bytes"
